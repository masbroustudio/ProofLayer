{
  "name": "prooflayer",
  "version": "0.1.0",
  "private": true,
  "description": "The Trust Compiler & Zero-Trust Policy Guard for Multi-Agent Systems",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "stress": "vitest run packages/server/tests/adversarial-stress.test.ts",
    "build": "npm --workspace=@prooflayer/studio run build",
    "dev": "concurrently \"npm run server\" \"npm run studio\"",
    "server": "npm --workspace=@prooflayer/server run dev",
    "studio": "npm --workspace=@prooflayer/studio run dev",
    "dev:server": "npm --workspace=@prooflayer/server run dev",
    "dev:studio": "npm --workspace=@prooflayer/studio run dev"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
